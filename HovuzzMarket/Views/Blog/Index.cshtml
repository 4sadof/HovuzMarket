@model BlogVM
@{
    ViewData["Title"] = "Blog";
}
<!-- blog section -->

<section class="blog_section layout_padding">
    <div class="container">
        <div class="heading_container">
            <h2>
                Latest Blog
            </h2>
        </div>
        <div class="row">
            @foreach (Blog blog in Model.Blogs)
            {
                <div class="col-md-6 col-lg-4 mx-auto">
                    <div class="box">
                        <div class="img-box">
                            <img src="~/uploads/blogs/@blog.Image" alt="">
                        </div>
                        <div class="detail-box">
                            <h5>
                                @blog.Title
                            </h5>
                            <p>
                                @Html.Raw(blog.Description)
                            </p>
                            <a href="">
                                Read More
                            </a>
                        </div>
                    </div>
                </div>

            }
        </div>
    </div>
</section>

<!-- end blog section -->
